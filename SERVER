-- ================== COUNTDOWN ==================
status.Text = "SERVER HOP AKTIF"
for i = START_DELAY, 1, -1 do
    timer.Text = "Teleport dalam " .. i .. " detik"
    task.wait(1)
end
timer.Text = "Mencari server..."
-- ===============================================

-- ================== FETCH SERVER ==================
local function fetchServer()
    local cursor = nil
    local servers = {}

    for _ = 1, MAX_PAGES do
        local ok, body = pcall(function()
            local url =
                "https://games.roblox.com/v1/games/" .. placeId ..
                "/servers/Public?limit=100&sortOrder=Asc" ..
                (cursor and "&cursor=" .. cursor or "")
            return game:HttpGet(url)
        end)

        if not ok or not body then break end

        local data = HttpService:JSONDecode(body)
        if not data or not data.data then break end

        for _, s in ipairs(data.data) do
            if s.id ~= currentJobId and s.playing < s.maxPlayers then
                servers[#servers+1] = s.id
            end
        end

        if #servers > 0 then break end
        cursor = data.nextPageCursor
        if not cursor then break end
        task.wait(1.5)
    end

    if #servers > 0 then
        return servers[math.random(#servers)]
    end
end
-- ================================================

local target = fetchServer()
if target then
    status.Text = "TELEPORTING"
    timer.Text = "Server ditemukan"
    task.wait(1)
    TeleportService:TeleportToPlaceInstance(placeId, target, player)
else
    status.Text = "GAGAL"
    timer.Text = "Server tidak ditemukan"
end
