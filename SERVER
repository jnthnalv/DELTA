-- ================== CONFIG ==================
local COOLDOWN = 18          -- cooldown antar execute
local LOAD_DELAY = 15       -- delay setelah game loaded
-- ============================================

repeat task.wait() until game:IsLoaded()

-- ================== UI ==================
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "ServerHopUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.fromScale(0.32, 0.18)
frame.Position = UDim2.fromScale(0.34, 0.08)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.BackgroundTransparency = 0.1
frame.Active = true
frame.Draggable = true

local corner = Instance.new("UICorner", frame)
corner.CornerRadius = UDim.new(0, 14)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.fromScale(1, 0.3)
title.BackgroundTransparency = 1
title.Text = "SERVER HOP STATUS"
title.TextColor3 = Color3.fromRGB(200, 200, 200)
title.Font = Enum.Font.GothamBold
title.TextScaled = true

local status = Instance.new("TextLabel", frame)
status.Position = UDim2.fromScale(0, 0.35)
status.Size = UDim2.fromScale(1, 0.25)
status.BackgroundTransparency = 1
status.Text = "IDLE"
status.TextColor3 = Color3.fromRGB(120, 200, 255)
status.Font = Enum.Font.Gotham
status.TextScaled = true

local timer = Instance.new("TextLabel", frame)
timer.Position = UDim2.fromScale(0, 0.65)
timer.Size = UDim2.fromScale(1, 0.25)
timer.BackgroundTransparency = 1
timer.Text = "-"
timer.TextColor3 = Color3.fromRGB(180, 180, 180)
timer.Font = Enum.Font.Gotham
timer.TextScaled = true

local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color
end

-- ================== COOLDOWN ==================
_G.__SERVERHOP_LAST_RUN = _G.__SERVERHOP_LAST_RUN or 0
local now = os.clock()
local remaining = COOLDOWN - (now - _G.__SERVERHOP_LAST_RUN)

if remaining > 0 then
    setStatus("COOLDOWN", Color3.fromRGB(255, 180, 80))
    for i = math.ceil(remaining), 1, -1 do
        timer.Text = "Ready in " .. i .. "s"
        task.wait(1)
    end
    timer.Text = "Execute again"
    return
end

_G.__SERVERHOP_LAST_RUN = now

-- ================== SERVICES ==================
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local placeId = game.PlaceId
local currentJobId = game.JobId

-- ================== LOAD DELAY ==================
setStatus("INITIALIZING", Color3.fromRGB(180, 180, 255))
for i = LOAD_DELAY, 1, -1 do
    timer.Text = "Waiting " .. i .. "s"
    task.wait(1)
end

-- ================== SERVER FETCH ==================
local function fetchServer()
    setStatus("SEARCHING SERVER", Color3.fromRGB(120, 200, 255))
    timer.Text = "Requesting list..."

    local ok, body = pcall(function()
        return game:HttpGet(
            "https://games.roblox.com/v1/games/" ..
            placeId .. "/servers/Public?limit=100&sortOrder=Asc"
        )
    end)

    if not ok then
        return nil
    end

    local data = HttpService:JSONDecode(body)
    if not data or not data.data then
        return nil
    end

    for _, s in ipairs(data.data) do
        if s.id ~= currentJobId and s.playing < s.maxPlayers then
            return s.id
        end
    end
end

-- ================== TELEPORT ==================
local target = fetchServer()

if target then
    setStatus("TELEPORTING", Color3.fromRGB(120, 255, 120))
    timer.Text = "Switching server..."
    task.wait(1.2)

    pcall(function()
        TeleportService:TeleportToPlaceInstance(
            placeId,
            target,
            player,
            nil,
            { queueTeleport = true }
        )
    end)
else
    setStatus("FAILED", Color3.fromRGB(255, 100, 100))
    timer.Text = "No server found"
end
