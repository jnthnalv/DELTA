-- CONFIG
local PLACE_ID = game.PlaceId
local MAX_WAIT = 8 -- detik nunggu teleport publik
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

-- STATE
local teleported = false
local startTime = tick()

-- LISTEN ERROR TELEPORT
TeleportService.TeleportInitFailed:Connect(function(plr, result, err)
	if plr ~= player then return end
	if teleported then return end

	warn("Public teleport failed:", result, err)
	teleported = true
	task.delay(0.5, function()
		-- FALLBACK KE PRIVATE
		local code = TeleportService:ReserveServer(PLACE_ID)
		TeleportService:TeleportToPrivateServer(PLACE_ID, code, {player})
	end)
end)

-- COBA TELEPORT KE PUBLIK RANDOM
task.spawn(function()
	pcall(function()
		TeleportService:Teleport(PLACE_ID)
	end)
end)

-- TIMEOUT GUARD (SILENT FAIL)
task.spawn(function()
	while not teleported do
		if tick() - startTime > MAX_WAIT then
			warn("Public teleport timeout, switching to private")
			teleported = true
			local code = TeleportService:ReserveServer(PLACE_ID)
			TeleportService:TeleportToPrivateServer(PLACE_ID, code, {player})
			break
		end
		task.wait(0.5)
	end
end)
