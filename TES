-- ================== FINAL TELEPORT FIX ==================
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local player = Players.LocalPlayer
if not player then return end

-- ===== TARGET DARI LINK =====
local PLACE_ID = 121864768012064
local TARGET_JOB_ID = "1c297da8-c0bb-4e56-abc1-88416694d5ed"

-- ===== PRIVATE FALLBACK =====
local PRIVATE_SERVER_CODE = "6cda54ffe43b1f49a578041109454182"

-- ===== KONTROL =====
local CHECK_INTERVAL = 4
local MAX_INSTANCE_TRY = 3

local originalJobId = game.JobId
local instanceTry = 0
local teleportStarted = false

-- ===== EVENT VERIFIKASI =====
TeleportService.OnTeleport:Connect(function(state)
    if state == Enum.TeleportState.Started then
        teleportStarted = true
    end
end)

TeleportService.TeleportInitFailed:Connect(function()
    teleportStarted = false
end)

-- ===== FUNGSI TELEPORT INSTANCE =====
local function teleportToInstance()
    instanceTry += 1
    teleportStarted = false

    pcall(function()
        TeleportService:TeleportToPlaceInstance(
            PLACE_ID,
            TARGET_JOB_ID,
            {player}
        )
    end)
end

-- ===== FUNGSI TELEPORT PRIVATE =====
local function teleportToPrivate()
    teleportStarted = false

    pcall(function()
        TeleportService:TeleportToPrivateServer(
            PLACE_ID,
            PRIVATE_SERVER_CODE,
            {player}
        )
    end)
end

-- ===== EKSEKUSI AWAL =====
teleportToInstance()

-- ===== WATCHDOG LOOP =====
task.spawn(function()
    while true do
        task.wait(CHECK_INTERVAL)

        -- sukses nyata: JobId berubah
        if game.JobId ~= originalJobId then
            break
        end

        -- jika instance gagal beberapa kali → private
        if instanceTry >= MAX_INSTANCE_TRY then
            teleportToPrivate()
        else
            teleportToInstance()
        end
    end
end)
-- ========================================================
