repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local player = Players.LocalPlayer
local placeId = game.PlaceId
local oldJobId = game.JobId

local PRIVATE_CODE = "6cda54ffe43b1f49a578041109454182"

local teleported = false
local lastAttempt = 0

-- DETEKSI TELEPORT BENAR-BENAR DIMULAI
TeleportService.TeleportInitFailed:Connect(function()
    teleported = false
end)

TeleportService.OnTeleport:Connect(function(state)
    if state == Enum.TeleportState.Started then
        teleported = true
    end
end)

-- LOOP PAKSA
task.spawn(function()
    while true do
        task.wait(5)

        -- jika JobId berubah, STOP
        if game.JobId ~= oldJobId then
            break
        end

        -- throttle
        if os.clock() - lastAttempt < 6 then
            continue
        end
        lastAttempt = os.clock()

        -- paksa private server
        TeleportService:TeleportToPrivateServer(
            placeId,
            PRIVATE_CODE,
            {player}
        )
    end
end)
