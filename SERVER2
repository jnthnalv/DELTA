-- ================== KONFIG ==================
local START_DELAY = 20        -- DELAY SEBELUM HOP (DETIK)
local COOLDOWN = 8            -- ANTI DOUBLE EXECUTE
local MAX_PAGES = 2
local FETCH_TIMEOUT = 10      -- TIMEOUT UNTUK FETCH SERVER (DETIK)
-- ============================================

-- ===== RESET STATE SETIAP EXECUTE =====
_G.__SERVERHOP_LAST_RUN = _G.__SERVERHOP_LAST_RUN or 0
local now = os.clock()
if now - _G.__SERVERHOP_LAST_RUN < COOLDOWN then return end
_G.__SERVERHOP_LAST_RUN = now

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
if not player then return end

local placeId = game.PlaceId
local currentJobId = game.JobId

math.randomseed(os.clock()*1e6)

-- ================== UI ==================
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false
gui.Name = "ServerHopUI"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.fromScale(0.32, 0.14)
frame.Position = UDim2.fromScale(0.34, 0.10)
