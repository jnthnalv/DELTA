-- ================= SERVICES =================
local Players = game:GetService("Players")
local plr = Players.LocalPlayer

-- ================= CONFIG =================
local REFRESH_INTERVAL = 1.5

-- ================= COUNT FUNCTION =================
local function countCaveCrystal()
    local total = 0
    local found = false

    for _, v in ipairs(plr.PlayerGui:GetDescendants()) do
        if v:IsA("TextLabel")
        and v.Text == "Cave Crystal"
        and v.Visible == true then
            total += 1
            found = true
        end
    end

    return total, found
end

-- ================= UI =================
local gui = Instance.new("ScreenGui")
gui.Name = "CaveCrystalCounter"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999999999
gui.Enabled = false -- 🔥 default HIDDEN
gui.Parent = plr.PlayerGui

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.fromOffset(280, 90)
frame.Position = UDim2.fromScale(0.5, 0.05)
frame.AnchorPoint = Vector2.new(0.5, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BorderSizePixel = 0
frame.ZIndex = 999

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1, 0, 0.4, 0)
title.BackgroundTransparency = 1
title.Text = "CAVE CRYSTAL"
title.Font = Enum.Font.SourceSansBold
title.TextScaled = true
title.TextColor3 = Color3.new(1,1,1)
title.ZIndex = 1000

local result = Instance.new("TextLabel")
result.Parent = frame
result.Position = UDim2.new(0, 0, 0.45, 0)
result.Size = UDim2.new(1, 0, 0.5, 0)
result.BackgroundTransparency = 1
result.Text = "TOTAL: 0"
result.Font = Enum.Font.SourceSansBold
result.TextScaled = true
result.TextColor3 = Color3.fromRGB(0, 255, 150)
result.ZIndex = 1000

-- ================= AUTO LOOP =================
task.spawn(function()
    while true do
        local total, found = countCaveCrystal()

        if found then
            gui.Enabled = true
            result.Text = "TOTAL: " .. total
        else
            gui.Enabled = false -- 🔥 tas ditutup → UI hilang
        end

        task.wait(REFRESH_INTERVAL)
    end
end)

print("✅ Cave Crystal Counter (UI only when inventory open) Loaded")
