-- AUTO TRADE GUI FIX (Delta Compatible)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Ganti sesuai Remote di game (cek RemoteSpy Delta)
local TradeRemote = ReplicatedStorage:WaitForChild("TradeRemote")

-- Buat GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoTradeGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 220, 0, 140)
Frame.Position = UDim2.new(0.35, 0, 0.3, 0)
Frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(40,40,40)
Title.Text = "AUTO TRADE"
Title.TextColor3 = Color3.fromRGB(255,255,255)
Title.TextScaled = true
Title.Parent = Frame

local PlayerBox = Instance.new("TextBox")
PlayerBox.PlaceholderText = "Nama Target Player"
PlayerBox.Size = UDim2.new(1, -20, 0, 30)
PlayerBox.Position = UDim2.new(0, 10, 0, 40)
PlayerBox.BackgroundColor3 = Color3.fromRGB(50,50,50)
PlayerBox.TextColor3 = Color3.fromRGB(255,255,255)
PlayerBox.Parent = Frame

local AmountBox = Instance.new("TextBox")
AmountBox.PlaceholderText = "Jumlah Item"
AmountBox.Size = UDim2.new(1, -20, 0, 30)
AmountBox.Position = UDim2.new(0, 10, 0, 75)
AmountBox.BackgroundColor3 = Color3.fromRGB(50,50,50)
AmountBox.TextColor3 = Color3.fromRGB(255,255,255)
AmountBox.Parent = Frame

local StartBtn = Instance.new("TextButton")
StartBtn.Size = UDim2.new(1, -20, 0, 30)
StartBtn.Position = UDim2.new(0, 10, 0, 110)
StartBtn.Text = "KIRIM"
StartBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
StartBtn.TextColor3 = Color3.fromRGB(255,255,255)
StartBtn.Parent = Frame

-- Fungsi auto trade
local function AutoTrade(target, jumlah)
    for i = 1, jumlah do
        task.wait(1.5)
        TradeRemote:FireServer(target, "SendItem", {
            Item = "Fish", -- ganti sesuai item asli
            Amount = 1
        })
        warn("[AUTO TRADE] Kirim ke " .. target .. " (" .. i .. "/" .. jumlah .. ")")
    end
end

StartBtn.MouseButton1Click:Connect(function()
    local target = PlayerBox.Text
    local jumlah = tonumber(AmountBox.Text)

    if target == "" or not jumlah then
        warn("[AUTO TRADE] Isi data dengan benar!")
        return
    end

    AutoTrade(target, jumlah)
end)
